<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dkst_markdown_browser"
        Arguments=""
        InstallLocation="C:\Program Files\DINKIssTyle\DKST Markdown Browser">
    </Installer>
    <PackageInformation
        PackageName="DKST Markdown Browser"
        PackageDisplayName="DKST Markdown Browser"
        PublisherName="CN=DINKIssTyle"
        PublisherDisplayName="DINKIssTyle"
        Version="2.2.4.0"
        PackageDescription="An elegant cross-platform viewer for Markdown and HTML files.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.dinkisstyle.mdbrowser"
                Description="An elegant cross-platform viewer for Markdown and HTML files."
                DisplayName="DKST Markdown Browser"
                ExecutableName="dkst_markdown_browser"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>DKST Markdown Browser</DisplayName>
            <PublisherDisplayName>DINKIssTyle</PublisherDisplayName>
            <Description>An elegant cross-platform viewer for Markdown and HTML files.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dkst_markdown_browser.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
